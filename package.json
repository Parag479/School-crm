{
  "name": "edumanage-school-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Complete School Website and School Management ERP CRM for Schools in India",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "build:backend": "npm --prefix apps/backend run build",
    "build:frontend": "npm --prefix apps/frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm --prefix apps/backend run test",
    "lint": "npm --prefix apps/frontend run lint",
    "db:generate": "npm --prefix apps/backend run db:generate",
    "db:seed": "npm --prefix apps/backend run db:seed"
  },
  "keywords": [
    "school-erp",
    "school-crm",
    "education-management",
    "edtech",
    "react",
    "nodejs",
    "prisma",
    "postgresql"
  ],
  "author": "EduManage Technologies",
  "license": "MIT"
}

